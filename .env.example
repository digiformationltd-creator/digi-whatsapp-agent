# ==============================================================================
# UNIVERSAL WHATSAPP SALES AGENT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Default UI & API port)
PORT=9010
NODE_ENV=development

# Data & Knowledge Paths
# Sessions, SQLite database, and conversation memories are stored here.
MYRAA_DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge

# ------------------------------------------------------------------------------
# AI Provider Keys
# ------------------------------------------------------------------------------

# 1. Google Gemini API Key (World-class multilingual Roman Urdu & English)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq Cloud API Key (Primary ultra-fast reasoning & Whisper STT)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. Cloudflare Workers AI (Serverless Edge Inference - Free 10,000 neurons daily)
# Get Account ID & Token at: https://dash.cloudflare.com/?to=/:account/ai/workers-ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct

# 4. OpenCode Zen API Key (Fallback reasoning layer)
# Get your free key at: https://opencode.ai
WHATSAPP_AGENT_KEY=your_opencode_zen_key_here
WHATSAPP_AGENT_BASE_URL=https://opencode.ai/zen/v1
WHATSAPP_AGENT_MODEL=nemotron-3-ultra-free

# ------------------------------------------------------------------------------
# WhatsApp Channel Restrictions (Optional)
# ------------------------------------------------------------------------------
# Comma-separated international phone numbers without + (e.g. 923001234567,447123456789)
# Leave empty to allow the agent to converse with all direct 1-on-1 chats
WHATSAPP_ALLOWED=
