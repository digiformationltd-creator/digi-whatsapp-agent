{
  "name": "whatsapp-agent",
  "version": "1.0.0",
  "description": "Standalone WhatsApp Agent with QR pairing, auto-reply, and knowledge base",
  "author": "Digiformation Ltd",
  "type": "module",
  "main": "dist/backend/server.cjs",
  "scripts": {
    "dev": "tsx src/backend/server.ts",
    "build": "tsc --noEmit && vite build && esbuild src/backend/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/backend/server.cjs && esbuild src/backend/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/backend/server.js",
    "start": "node dist/backend/server.cjs",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "test": "npx tsx scripts/test_master_10_phases.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "tesseract.js@7.0.0": true
  }
}
